# This template contains no credentials. The default scripted demo needs no .env file.
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
APP_ACCESS_TOKEN=
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Live answers: configure your own compatible provider. Never put these in EXPO_PUBLIC_*.
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_THINKING=default
LLM_TOKEN_PARAMETER=max_tokens

# Live local ASR: install its optional runtime/models before npm run dev.
# The demo command overrides this setting and does not install or run ASR.
ASR_PROVIDER=local
ASR_LOCAL_URL=ws://127.0.0.1:8765
ASR_LOCAL_TOKEN=

# Alternative cloud ASR requires your own provider settings and credentials.
ASR_API_KEY=
ASR_MODEL=
