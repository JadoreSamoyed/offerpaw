{
  "cli": {"version": ">= 16.0.0", "appVersionSource": "local"},
  "build": {
    "development": {"developmentClient": true, "distribution": "internal", "env": {"APP_ALLOW_LOCAL_HTTP": "1"}},
    "preview": {"distribution": "internal", "env": {"APP_ALLOW_LOCAL_HTTP": "0"}, "android": {"buildType": "apk"}},
    "ios-simulator": {"extends": "preview", "ios": {"simulator": true}},
    "production": {"autoIncrement": true, "env": {"APP_ALLOW_LOCAL_HTTP": "0"}}
  },
  "submit": {"production": {}}
}
