{
  "name": "@interview/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "web": "expo start --web --localhost --port 8081",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild:android": "node ../../scripts/prebuild-mobile.mjs --platform android --no-install",
    "prebuild:ios": "node ../../scripts/prebuild-mobile.mjs --platform ios --no-install",
    "export:native": "expo export --platform all --output-dir dist-native",
    "build": "expo export --platform web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.16",
    "expo-clipboard": "~58.0.3",
    "expo-dev-client": "~58.0.14",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-keep-awake": "~58.0.3",
    "expo-modules-core": "~58.0.23",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.19",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "~6.0.3"
  }
}
